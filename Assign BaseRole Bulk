# ============================================================
# Bulk Role Assignment by Email
# Reads a CSV with email + role columns. For each row:
#   - Constructs username as "sitecore\<email>" (matches the existing convention)
#   - Creates the user if they don't exist
#   - Adds them as a member of the role
#
# This script does NOT rely on profile email lookups - the username is
# derived directly from the CSV email, so we always know what to check for.
# ============================================================

function Read-CsvFromMedia {
    param([object]$MediaItemOrPath)

    $item = if ($MediaItemOrPath -is [Sitecore.Data.Items.Item]) {
        $MediaItemOrPath
    } else {
        Get-Item -Path $MediaItemOrPath -ErrorAction SilentlyContinue
    }

    if (-not $item) {
        Show-Alert "Media item not found."
        return $null
    }

    $mediaItem = New-Object Sitecore.Data.Items.MediaItem($item)
    $stream = $null
    $reader = $null

    try {
        $stream = $mediaItem.GetMediaStream()
        if (-not $stream) {
            Show-Alert "Could not read media stream from: $($item.Paths.FullPath)"
            return $null
        }

        $reader  = New-Object System.IO.StreamReader($stream, [System.Text.UTF8Encoding]::new($false))
        $csvText = $reader.ReadToEnd()
        return ConvertFrom-Csv -InputObject $csvText
    }
    finally {
        if ($reader) { $reader.Dispose() }
        if ($stream) { $stream.Dispose() }
    }
}

function Get-UsernameFromEmail {
    param([string]$Email, [string]$DomainName)
    # Username convention in this environment: domain\<full email>
    # e.g. sitecore\ashley.gillis1@ascension.org
    return "$DomainName\$($Email.Trim())"
}

function New-SitecoreUserFromEmail {
    param([string]$Email, [string]$DomainName)

    $userName = Get-UsernameFromEmail -Email $Email -DomainName $DomainName

    # Derive first/last name from the local part of the email for the profile.
    # Best-effort - users with non-standard emails may need their profile fixed manually.
    $localPart = $Email.Trim().Split("@")[0]
    $nameParts = $localPart.Split(".")
    $firstName = if ($nameParts.Count -ge 1) { (Get-Culture).TextInfo.ToTitleCase(($nameParts[0] -replace "[0-9]", "")) } else { $localPart }
    $lastName  = if ($nameParts.Count -ge 2) { (Get-Culture).TextInfo.ToTitleCase(($nameParts[1] -replace "[0-9]", "")) } else { "" }

    # Random GUID password - not used for login because this environment is SSO/SAML federated
    # Note: -Enabled parameter is not present in all SPE versions, so we set Enabled via property assignment after creation.
    $newUser = New-User -Identity $userName `
                        -Email $Email `
                        -Password ([System.Guid]::NewGuid().ToString() + "!Aa1") `
                        -Enabled `
                        -ErrorAction Stop

    Enable-User -Identity $userName

    # Set profile fields - useful for any tools that rely on profile email later
    Set-User -Identity $userName -Email $Email -FullName "$firstName $lastName".Trim()
    return $newUser
}


# ============================================================
# Dialog
# ============================================================
$dialogParams = @(
    @{
        Name       = "csvMediaItem"
        Title      = "CSV File"
        Editor     = "item"
        Parameters = @{
            DatabaseName                 = "master"
            Root                         = "master:/sitecore/media library"
            IncludeTemplatesForSelection = "File|Unversioned File"
            ExcludeTemplatesForSelection = "Media folder"
            Selection                    = "Single"
        }
    },
    @{
        Name    = "domainName"
        Title   = "User Domain"
        Tooltip = "The Sitecore domain to create users in"
        Editor  = "text"
        Value   = "sitecore"
    },
    @{
        Name    = "dryRun"
        Title   = "Dry Run"
        Tooltip = "Preview only - no changes will be made"
        Editor  = "check"
        Value   = $true
    }
)

$result = Read-Variable -Parameters $dialogParams `
    -Title "Assign Roles to Users by Email" `
    -Description "Select the CSV file from the Media Library. Users will be created if they do not exist." `
    -Width 500 `
    -Height 300 `
    -OkButtonName "Run" `
    -CancelButtonName "Cancel"

if ($result -ne "ok") {
    Show-Alert "Script cancelled."
    return
}

if (-not $csvMediaItem) {
    Show-Alert "No CSV selected."
    return
}

# Defensive: in some SPE configurations Read-Variable values don't bind cleanly
# to script scope. If $dryRun ends up $null we treat it as if dry-run is on,
# rather than risk silent live writes. This is fail-safe behavior.
if ($null -eq $dryRun) {
    Show-Alert "Dry Run setting could not be read from the dialog. Aborting to be safe."
    return
}
$dryRun = [bool]$dryRun


# ============================================================
# Read CSV and validate columns
# ============================================================
$csvData = Read-CsvFromMedia $csvMediaItem

if (-not $csvData -or $csvData.Count -eq 0) {
    Show-Alert "CSV file is empty or could not be read."
    return
}

$emailColumn = "page author (required)"
$roleColumn  = "Sitecore Role name"
$columns     = $csvData[0].PSObject.Properties.Name

$missingColumns = @()
if ($emailColumn -notin $columns) { $missingColumns += $emailColumn }
if ($roleColumn  -notin $columns) { $missingColumns += $roleColumn }

if ($missingColumns.Count -gt 0) {
    Show-Alert "CSV is missing required columns: $($missingColumns -join ', ')"
    return
}


# ============================================================
# Process rows
# ============================================================
$report     = [System.Collections.Generic.List[object]]::new()
$totalRows  = $csvData.Count
$currentRow = 0

foreach ($row in $csvData) {
    $currentRow++
    Write-Progress -Activity "Processing CSV" `
                   -Status "Row $currentRow of $totalRows" `
                   -PercentComplete (($currentRow / $totalRows) * 100)

    $email    = $row.$emailColumn
    $roleName = $row.$roleColumn

    $reportRow = [PSCustomObject]@{
        Email    = $email
        UserName = ""
        Role     = $roleName
        Status   = ""
        Notes    = ""
    }

    # Validate input
    if ([string]::IsNullOrWhiteSpace($email) -or [string]::IsNullOrWhiteSpace($roleName)) {
        $reportRow.Status = "SKIPPED"
        $reportRow.Notes  = "Missing email or role"
        $report.Add($reportRow)
        continue
    }

    # Validate role exists
    $role = Get-Role -Identity $roleName -ErrorAction SilentlyContinue
    if (-not $role) {
        $reportRow.Status = "ROLE_NOT_FOUND"
        $reportRow.Notes  = "Role '$roleName' does not exist"
        $report.Add($reportRow)
        continue
    }

    # Build the username deterministically and look it up directly.
    # Convention here: sitecore\<email>, e.g. sitecore\ashley.gillis1@ascension.org
    $userName           = Get-UsernameFromEmail -Email $email -DomainName $domainName
    $reportRow.UserName = $userName

    $user = Get-User -Identity $userName -ErrorAction SilentlyContinue

    if (-not $user) {
        # User doesn't exist - create them (or preview)
        if ($dryRun) {
            $reportRow.Status = "DRY_RUN"
            $reportRow.Notes  = "User does not exist - would be created and assigned to role"
            $report.Add($reportRow)
            continue
        }

        try {
            $user = New-SitecoreUserFromEmail -Email $email -DomainName $domainName
            $reportRow.Notes += "User created | "
        } catch {
            $reportRow.Status = "ERROR"
            $reportRow.Notes  = "Failed to create user: $($_.Exception.Message)"
            $report.Add($reportRow)
            continue
        }
    }

    # Check existing role membership.
    # Using Get-RoleMember instead of Test-Account because the -Role parameter
    # of Test-Account is not present in all SPE versions.
    $existingMembers = Get-RoleMember -Identity $roleName -ErrorAction SilentlyContinue
    $alreadyInRole   = $false
    if ($existingMembers) {
        foreach ($m in $existingMembers) {
            if ($m.Name -ieq $userName) {
                $alreadyInRole = $true
                break
            }
        }
    }
    if ($alreadyInRole) {
        $reportRow.Status = "ALREADY_IN_ROLE"
        $reportRow.Notes += "User already has this role"
        $report.Add($reportRow)
        continue
    }

    # Assign role or preview
    if ($dryRun) {
        $reportRow.Status = "DRY_RUN"
        $reportRow.Notes += "Role would be assigned"
    } else {
        try {
            Add-RoleMember -Identity $roleName -Members $userName
            $reportRow.Status = "ASSIGNED"
            $reportRow.Notes += "Role assigned"
        } catch {
            # Use += so a prior "User created" note isn't lost when assignment fails.
            $reportRow.Status = "ERROR"
            $reportRow.Notes += "Role assignment failed: " + $_.Exception.Message
        }
    }

    $report.Add($reportRow)
}

Write-Progress -Activity "Processing CSV" -Completed


# ============================================================
# Output report
# ============================================================
$assigned     = ($report | Where-Object { $_.Status -eq "ASSIGNED"        }).Count
$created      = ($report | Where-Object { $_.Notes  -like "*User created*" }).Count
$alreadySet   = ($report | Where-Object { $_.Status -eq "ALREADY_IN_ROLE" }).Count
$roleNotFound = ($report | Where-Object { $_.Status -eq "ROLE_NOT_FOUND"  }).Count
$errors       = ($report | Where-Object { $_.Status -eq "ERROR"           }).Count
$skipped      = ($report | Where-Object { $_.Status -eq "SKIPPED"         }).Count

$title     = if ($dryRun) { "Bulk Role Assignment Report (DRY RUN)" } else { "Bulk Role Assignment Report" }
$infoTitle = if ($dryRun) {
    "Preview only - no changes made"
} else {
    "Assigned: $assigned | Created: $created | Already in role: $alreadySet | Role not found: $roleNotFound | Errors: $errors | Skipped: $skipped"
}

$report | Show-ListView `
    -Property `
        @{ Label = "Email";  Expression = { $_.Email } },
        @{ Label = "User";   Expression = { $_.UserName } },
        @{ Label = "Role";   Expression = { $_.Role } },
        @{ Label = "Status"; Expression = { $_.Status } },
        @{ Label = "Notes";  Expression = { $_.Notes } } `
    -Title $title `
    -InfoTitle $infoTitle `
    -InfoDescription "Processed $($report.Count) rows" `
    -PageSize 50

if ($dryRun) {
    Write-Host "DRY RUN complete. $($report.Count) rows previewed." -ForegroundColor Yellow
} else {
    Write-Host ("Done. Assigned: " + $assigned + " | Created: " + $created + " | Already in role: " + $alreadySet + " | Errors: " + $errors) -ForegroundColor Green
}
