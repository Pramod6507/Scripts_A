# Bulk Page Owner Permissions REMOVAL Script
# Reads the same CSV used to apply permissions and removes all ACL entries
# for roles listed in the CSV. Only removes those specific roles; any other
# accounts on the same item are left untouched.
# CSV must have columns matching: "Item path" and "Role name"

# ============================================================
# REUSABLE FUNCTION: Format an AccessRuleCollection as a readable string.
#   Manually builds the representation from each rule's properties since
#   AccessRuleSerializer::Serialize is not available in this Sitecore version.
#   Output format per rule: "Account [PropagationType]: +right1 -right2 ..."
#   Returns "(none)" if the collection is null or empty.
# ============================================================
function Format-AclString {
    param([Sitecore.Security.AccessControl.AccessRuleCollection] $Rules)

    if (-not $Rules -or $Rules.Count -eq 0) {
        return "(none)"
    }

    # Group rules by account+propagation so each combination appears once
    $grouped = @{}
    foreach ($rule in $Rules) {
        $key = $rule.Account.Name + " [" + $rule.PropagationType + "]"
        if (-not $grouped.ContainsKey($key)) {
            $grouped[$key] = [System.Collections.Generic.List[string]]::new()
        }
        $prefix = if ($rule.SecurityPermission -eq "AllowAccess") { "+" } else { "-" }
        $grouped[$key].Add($prefix + $rule.AccessRight.Name)
    }

    $parts = [System.Collections.Generic.List[string]]::new()
    foreach ($entry in $grouped.GetEnumerator()) {
        $parts.Add($entry.Key + ": " + ($entry.Value -join " "))
    }

    return $parts -join "; "
}


# ============================================================
# REUSABLE FUNCTION: Remove all ACL entries for a given role from an item.
#   Returns a hashtable:
#     @{ Changed = $bool; OldValue = "raw acl string"; NewValue = "raw acl string" }
#   OldValue/NewValue are the serialized security field before and after the change.
# ============================================================
function Remove-RoleFromItemAcl {
    param(
        [Sitecore.Data.Items.Item] $Item,
        [string]                   $RoleName
    )

    $result = @{ Changed = $false; OldValue = "(none)"; NewValue = "(none)" }

    if (-not $Item -or [string]::IsNullOrWhiteSpace($RoleName)) {
        return $result
    }

    $normalizedRoleName = $RoleName.Trim()

    # Use SPE Get-ItemAcl/Set-ItemAcl for read+write so writes persist correctly
    # under EventDisabler. Item.Security.SetAccessRules has been observed to NOT
    # persist when events are disabled - the in-memory collection updates but the
    # __Security field is never written, leading to "report says removed but
    # Sitecore still shows the role" - exactly what happened in the pre-prod run.
    $existingRules   = @(Get-ItemAcl -Item $Item)

    # Format-AclString accepts an AccessRuleCollection; build one from the array
    $existingCollection = New-Object Sitecore.Security.AccessControl.AccessRuleCollection
    foreach ($r in $existingRules) { $existingCollection.Add($r) }
    $result.OldValue = Format-AclString $existingCollection

    if (-not $existingRules -or $existingRules.Count -eq 0) {
        return $result
    }

    $rulesToKeepArr = @()
    $removedCount   = 0

    foreach ($rule in $existingRules) {
        $accountName = if ($rule.Account) { $rule.Account.Name } else { "" }
        if ($accountName -ieq $normalizedRoleName) {
            $removedCount++
        } else {
            $rulesToKeepArr += $rule
        }
    }

    if ($removedCount -eq 0) {
        $result.NewValue = $result.OldValue
        return $result
    }

    # Persist via Set-ItemAcl (works correctly under EventDisabler)
    Set-ItemAcl -Item $Item -AccessRules $rulesToKeepArr | Out-Null

    # Build a fresh collection for the After-string display
    $rulesToKeepCollection = New-Object Sitecore.Security.AccessControl.AccessRuleCollection
    foreach ($r in $rulesToKeepArr) { $rulesToKeepCollection.Add($r) }

    $result.Changed  = $true
    $result.NewValue = Format-AclString $rulesToKeepCollection
    return $result
}


# ============================================================
# HELPER: Build a note line showing before/after ACL for one item.
#   In dry run, reads the live ACL and projects what the result would be.
#   In live run, uses the hashtable returned by Remove-RoleFromItemAcl.
# ============================================================
function Get-AclChangeNote {
    param(
        [string]                   $ItemLabel,
        [hashtable]                $AclResult,
        [Sitecore.Data.Items.Item] $Item,
        [string]                   $RoleName,
        [bool]                     $IsDryRun
    )

    if ($IsDryRun) {
        $existingRules = @(Get-ItemAcl -Item $Item)

        $existingCollection = New-Object Sitecore.Security.AccessControl.AccessRuleCollection
        foreach ($r in $existingRules) { $existingCollection.Add($r) }
        $currentAcl = Format-AclString $existingCollection

        $rulesToKeep = New-Object Sitecore.Security.AccessControl.AccessRuleCollection
        foreach ($rule in $existingRules) {
            $accountName = if ($rule.Account) { $rule.Account.Name } else { "" }
            if ($accountName -ine $RoleName) {
                $rulesToKeep.Add($rule)
            }
        }
        $projectedAcl = Format-AclString $rulesToKeep

        return "[DRY RUN] $ItemLabel | Before: $currentAcl | After (projected): $projectedAcl"
    }

    if (-not $AclResult.Changed) {
        return "$ItemLabel | No entries for role - unchanged: $($AclResult.OldValue)"
    }

    return "$ItemLabel | Before: $($AclResult.OldValue) | After: $($AclResult.NewValue)"
}


# ============================================================
# REUSABLE FUNCTION: Walk up ancestors to find the site item
#    Returns the first ancestor whose template matches _AscensionSite
# ============================================================
$AscensionSiteTemplateId     = [Sitecore.Data.ID]::Parse("{7F81B515-EB46-43D6-AF06-264740F66AC3}")
$AscensionSiteDataTemplateId = "{88072C0A-6A7D-4992-93FA-F37AE67023AA}"

function Get-ParentSite {
    param(
        [Sitecore.Data.Items.Item]                $Item,
        [System.Collections.Generic.List[object]] $Sites
    )
    foreach ($site in $Sites) {
        if (
            $Item.ID -eq $site.ID -or
            $Item.Paths.FullPath.StartsWith($site.Paths.FullPath + "/", [System.StringComparison]::OrdinalIgnoreCase)
        ) {
            return $site
        }
    }
    return $null
}


# ============================================================
# REUSABLE FUNCTION: Read CSV content from a Sitecore media item
# ============================================================
function Read-CsvFromMedia {
    param([object]$MediaItemOrPath)

    $item = if ($MediaItemOrPath -is [Sitecore.Data.Items.Item]) {
        $MediaItemOrPath
    } else {
        Get-Item -Path $MediaItemOrPath -ErrorAction SilentlyContinue
    }

    if (-not $item) {
        Show-Alert "Media item not found."
        return $null
    }

    $mediaItem = New-Object Sitecore.Data.Items.MediaItem($item)
    $stream    = $mediaItem.GetMediaStream()

    if (-not $stream) {
        Show-Alert "Could not read media stream from: $($item.Paths.FullPath)"
        return $null
    }

    $reader  = New-Object System.IO.StreamReader($stream, [Text.UTF8Encoding]::UTF8)
    $csvText = $reader.ReadToEnd()
    $reader.Close()
    $stream.Close()

    return ConvertFrom-Csv -InputObject $csvText
}


# ============================================================
# 1: Preload all site items (same logic as apply script)
# ============================================================
Write-Host "Loading sites..." -ForegroundColor Cyan

$db    = [Sitecore.Configuration.Factory]::GetDatabase("master")
$root  = $db.GetItem("/sitecore/content/Intranet Evolution")
$sites = [System.Collections.Generic.List[object]]::new()

foreach ($descendant in $root.Axes.GetDescendants()) {
    $isSite = $false
    foreach ($bt in $descendant.Template.BaseTemplates) {
        if ($bt.ID.ToString() -eq "{7F81B515-EB46-43D6-AF06-264740F66AC3}") {
            $isSite = $true
            break
        }
    }
    if ($isSite) {
        $sites.Add($descendant)
    }
}

if ($sites.Count -eq 0) {
    Show-Alert "No sites found under /sitecore/content/Intranet Evolution. Please verify the _AscensionSite template name."
    return
}

Write-Host ("Found " + $sites.Count + " site(s).") -ForegroundColor Cyan


# ============================================================
# 2: Dialog - CSV media item picker
# ============================================================
$result1 = Read-Variable -Parameters @(
    @{
        Name       = "csvMediaItem"
        Title      = "Page Owner CSV (same file used to apply permissions)"
        Editor     = "item"
        Parameters = @{
            DatabaseName                 = "master"
            Root                         = "master:/sitecore/media library"
            IncludeTemplatesForSelection = "File|Unversioned File"
            ExcludeTemplatesForSelection = "Media folder"
            Selection                    = "Single"
        }
    },
    @{
        Name    = "removeRolesFromSitecore"
        Title   = "Also DELETE the roles from Sitecore (irreversible)"
        Tooltip = "When checked, each role found in the CSV will be permanently deleted after its permissions are removed. Cannot be undone."
        Editor  = "check"
        Value   = $false
    },
    @{
        Name    = "dryRun"
        Title   = "Dry Run (preview only - no changes will be made)"
        Tooltip = "When checked, the script will show what would be removed without making any changes"
        Editor  = "check"
        Value   = $true
    }
) `
-Title "Remove Page Owner Permissions" `
-Description "Removes all ACL entries set by the apply script for roles in the CSV.`nOther roles on the same items are NOT affected." `
-Width 550 `
-Height 380 `
-OkButtonName "Next" `
-CancelButtonName "Cancel"

if ($result1 -ne "ok") {
    Show-Alert "Script cancelled by user."
    return
}


# ============================================================
# 3: Read CSV from media item and detect columns
# ============================================================
if (-not $csvMediaItem) {
    Show-Alert "No CSV file selected. Script cancelled."
    return
}

$csvData = Read-CsvFromMedia $csvMediaItem

if (-not $csvData -or $csvData.Count -eq 0) {
    Show-Alert "CSV file is empty or could not be read."
    return
}

$itemPathColumn = $csvData[0].PSObject.Properties.Name | Where-Object { $_ -like "*Item path*" }
$roleColumn     = $csvData[0].PSObject.Properties.Name | Where-Object { $_ -like "*Role name*" }

if (-not $itemPathColumn -or -not $roleColumn) {
    Show-Alert "CSV must contain columns matching 'Item path' and 'Role name'.`nFound: $($csvData[0].PSObject.Properties.Name -join ', ')"
    return
}

$validRows = $csvData | Where-Object {
    -not [string]::IsNullOrWhiteSpace($_.$itemPathColumn) -and
    -not [string]::IsNullOrWhiteSpace($_.$roleColumn)
}

if ($validRows.Count -eq 0) {
    Show-Alert "No valid rows found in CSV."
    return
}

# Collect unique roles across entire CSV upfront (used for role-level cleanup)
$allCsvRoles = ($validRows | ForEach-Object { ($_.($roleColumn).Trim() -replace "[^\x20-\x7E]", "").Trim() } | Sort-Object -Unique)


# ============================================================
# 4: Confirm before proceeding
# ============================================================
$deleteRoleMsg = if ($removeRolesFromSitecore) { "YES - roles will be permanently deleted" } else { "NO" }
$dryRunMsg     = if ($dryRun) { "YES - no changes will be made" } else { "NO - permissions WILL be removed" }

$confirmMsg = "Rows to process : $($validRows.Count)`nUnique roles    : $($allCsvRoles.Count)`nSites loaded    : $($sites.Count)`nDelete roles    : $deleteRoleMsg`nDry Run         : $dryRunMsg`n`nThis will remove ALL ACL entries for CSV roles from:`n  - Page items`n  - Ancestor items (walked to root)`n  - Site items`n  - Page Data folders`n  - Site Data folders`n  - Global Data folder`n  - Media library root`n  - Media folders + media ancestors`n  - Core DB archive/publish restriction items`n`nProceed?"

$confirm = Show-ModalDialog -Control "ConfirmChoice" `
    -Parameters @{
        btn_0 = "Yes, Remove Permissions"
        btn_1 = "Cancel"
        te    = $confirmMsg
        cp    = "Confirm Permission Removal"
    } `
    -Height 340 -Width 720

if ($confirm -ne "btn_0") {
    Show-Alert "Operation cancelled."
    return
}


# ============================================================
# 5: Static paths that were touched by the apply script
#    (role-level items in core db - applied once per role)
# ============================================================
$ArchiveCommandPaths = @(
    "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Schedule",
    "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Schedule/Archive"
)

$PublishRestrictionsPaths = @(
    "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Publish Restrictions",
    "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Publish Restrictions/Change"
)

$MediaLibraryRoot = "master:/sitecore/media library/Project/Intranet Evolution/DFD"
# FIX: previous version was missing the 'sitecore' segment, causing the global
# data folder to be silently skipped. Path corrected.
$GlobalDataPath   = "master:\sitecore\content\Intranet Evolution\DFD\Data"


# ============================================================
# 6: Role-level cleanup - items touched once per role regardless of page count
#    Run upfront so the per-row loop only handles page/ancestor/media items
# ============================================================
$processedRoles = [System.Collections.Generic.HashSet[string]]::new()

$eventDisabler = New-Object Sitecore.Data.Events.EventDisabler
try {

foreach ($roleName in $allCsvRoles) {

    # -- Media library root (scoped to DFD project root, matching what the apply script touched) --
    $mediaLibraryItem = Get-Item -Path $MediaLibraryRoot -ErrorAction SilentlyContinue
    if ($mediaLibraryItem) {
        if ($dryRun) {
            Write-Host ("[DRY RUN] Would remove '$roleName' from media library root") -ForegroundColor Yellow
        } else {
            Remove-RoleFromItemAcl -Item $mediaLibraryItem -RoleName $roleName | Out-Null
            Write-Host ("[INFO] Removed '$roleName' from media library root") -ForegroundColor Gray
        }
    }

    # -- Core DB: archive commands --
    foreach ($archivePath in $ArchiveCommandPaths) {
        $archiveItem = Get-Item -Path $archivePath -ErrorAction SilentlyContinue
        if ($archiveItem) {
            if ($dryRun) {
                Write-Host ("[DRY RUN] Would remove '$roleName' from: $archivePath") -ForegroundColor Yellow
            } else {
                Remove-RoleFromItemAcl -Item $archiveItem -RoleName $roleName | Out-Null
                Write-Host ("[INFO] Removed '$roleName' from: $archivePath") -ForegroundColor Gray
            }
        } else {
            Write-Host ("[WARN] Archive item not found: $archivePath") -ForegroundColor Yellow
        }
    }

    # -- Core DB: publish restrictions --
    foreach ($publishPath in $PublishRestrictionsPaths) {
        $publishItem = Get-Item -Path $publishPath -ErrorAction SilentlyContinue
        if ($publishItem) {
            if ($dryRun) {
                Write-Host ("[DRY RUN] Would remove '$roleName' from: $publishPath") -ForegroundColor Yellow
            } else {
                Remove-RoleFromItemAcl -Item $publishItem -RoleName $roleName | Out-Null
                Write-Host ("[INFO] Removed '$roleName' from: $publishPath") -ForegroundColor Gray
            }
        } else {
            Write-Host ("[WARN] Publish restrictions item not found: $publishPath") -ForegroundColor Yellow
        }
    }

    # -- Global data folder --
    $globalDataItem = Get-Item -Path $GlobalDataPath -ErrorAction SilentlyContinue
    if ($globalDataItem) {
        if ($dryRun) {
            Write-Host ("[DRY RUN] Would remove '$roleName' from Global Data folder") -ForegroundColor Yellow
        } else {
            Remove-RoleFromItemAcl -Item $globalDataItem -RoleName $roleName | Out-Null
            Write-Host ("[INFO] Removed '$roleName' from Global Data folder") -ForegroundColor Gray
        }
    } else {
        Write-Host ("[WARN] Global Data folder not found at: $GlobalDataPath") -ForegroundColor Yellow
    }

    $processedRoles.Add($roleName) | Out-Null
}


# ============================================================
# 7: Process each CSV row - page items, ancestors, media, site items
# ============================================================
$report         = @()
$totalRows      = $validRows.Count
$currentRow     = 0
$processedSites = [System.Collections.Generic.HashSet[string]]::new()

# Single-line separator so each item's before/after stays on one row in Show-ListView
$noteSeparator = " || "

foreach ($row in $validRows) {
    $currentRow++
    Write-Progress -Activity "Removing Page Owner Permissions" `
                   -Status ("Row " + $currentRow + " of " + $totalRows + " - " + $row.$roleColumn) `
                   -PercentComplete (($currentRow / $totalRows) * 100)

    $itemPath = $row.$itemPathColumn.Trim()
    $roleName = ($row.$roleColumn.Trim() -replace "[^\x20-\x7E]", "").Trim()

    $reportRow = [PSCustomObject]@{
        ItemPath    = $itemPath
        Role        = $roleName
        Status      = ""
        MediaFolder = ""
        Notes       = ""
    }

    # Resolve Sitecore item path to SPE provider path
    $scPath        = $itemPath -replace "^/sitecore", "master:"
    $scPath        = $scPath -replace "/", "\"
    $foundPageItem = Get-Item -Path $scPath -ErrorAction SilentlyContinue

    if (-not $foundPageItem) {
        $reportRow.Status = "MISSING_PAGE"
        $reportRow.Notes  = "Item not found at path: $itemPath"
        $report += $reportRow
        continue
    }

    # Find the parent site
    $matchingSite = Get-ParentSite -Item $foundPageItem -Sites $sites

    # Collect one note line per item touched - each line is "Label | Before: ... | After: ..."
    $noteLines = [System.Collections.Generic.List[string]]::new()

    # -- Remove from site item --
    if ($matchingSite) {
        $siteRoleKey = $matchingSite.ID.ToString() + "|" + $roleName
        if (-not $processedSites.Contains($siteRoleKey)) {
            if ($dryRun) {
                $noteLines.Add((Get-AclChangeNote -ItemLabel ("Site: " + $matchingSite.Name) -AclResult $null -Item $matchingSite -RoleName $roleName -IsDryRun $true))
                $processedSites.Add($siteRoleKey) | Out-Null
            } else {
                try {
                    $aclResult = Remove-RoleFromItemAcl -Item $matchingSite -RoleName $roleName
                    $processedSites.Add($siteRoleKey) | Out-Null
                    $noteLines.Add((Get-AclChangeNote -ItemLabel ("Site: " + $matchingSite.Name) -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
                } catch {
                    $noteLines.Add("Site: " + $matchingSite.Name + " | ERROR: " + $_.Exception.Message)
                }
            }
        } else {
            $noteLines.Add("Site: " + $matchingSite.Name + " | Already processed for this role")
        }

        # -- Remove from Ascension Site Data folder --
        $siteDataItem = $matchingSite.Children | Where-Object {
            $_.TemplateID.ToString() -eq $AscensionSiteDataTemplateId
        } | Select-Object -First 1

        if ($siteDataItem) {
            if ($dryRun) {
                $noteLines.Add((Get-AclChangeNote -ItemLabel ("Site Data: " + $siteDataItem.Name) -AclResult $null -Item $siteDataItem -RoleName $roleName -IsDryRun $true))
            } else {
                try {
                    $aclResult = Remove-RoleFromItemAcl -Item $siteDataItem -RoleName $roleName
                    $noteLines.Add((Get-AclChangeNote -ItemLabel ("Site Data: " + $siteDataItem.Name) -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
                } catch {
                    $noteLines.Add("Site Data: " + $siteDataItem.Name + " | ERROR: " + $_.Exception.Message)
                }
            }
        } else {
            $noteLines.Add("Site Data: not found under " + $matchingSite.Name)
        }
    } else {
        $noteLines.Add("Site: no matching _AscensionSite ancestor found - site cleanup skipped")
    }

    # -- Remove from page item itself --
    if ($dryRun) {
        $reportRow.Status = "DRY_RUN"
        $noteLines.Add((Get-AclChangeNote -ItemLabel ("Page: " + $foundPageItem.Name) -AclResult $null -Item $foundPageItem -RoleName $roleName -IsDryRun $true))
    } else {
        try {
            $aclResult = Remove-RoleFromItemAcl -Item $foundPageItem -RoleName $roleName
            $reportRow.Status = "PERMISSIONS_REMOVED"
            $noteLines.Add((Get-AclChangeNote -ItemLabel ("Page: " + $foundPageItem.Name) -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
        } catch {
            $reportRow.Status = "PERMISSIONS_ERROR"
            $noteLines.Add("Page: " + $foundPageItem.Name + " | ERROR: " + $_.Exception.Message)
            $reportRow.Notes = $noteLines -join $noteSeparator
            $report += $reportRow
            continue
        }
    }

    # -- Remove from ancestor items (walks all the way to root) --
    $ancestorItem = $foundPageItem.Parent
    while ($ancestorItem -and $ancestorItem.ID -ne [Sitecore.Data.ID]::Parse("{11111111-1111-1111-1111-111111111111}")) {
        if ($dryRun) {
            $noteLines.Add((Get-AclChangeNote -ItemLabel ("Ancestor: " + $ancestorItem.Name) -AclResult $null -Item $ancestorItem -RoleName $roleName -IsDryRun $true))
        } else {
            $aclResult = Remove-RoleFromItemAcl -Item $ancestorItem -RoleName $roleName
            $noteLines.Add((Get-AclChangeNote -ItemLabel ("Ancestor: " + $ancestorItem.Name) -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
        }
        $ancestorItem = $ancestorItem.Parent
    }

    # -- Remove from Page Data folder --
    $pageDataPath = ($scPath + "\Page Data")
    $pageDataItem = Get-Item -Path $pageDataPath -ErrorAction SilentlyContinue

    if ($pageDataItem) {
        if ($dryRun) {
            $noteLines.Add((Get-AclChangeNote -ItemLabel "Page Data" -AclResult $null -Item $pageDataItem -RoleName $roleName -IsDryRun $true))
        } else {
            try {
                $aclResult = Remove-RoleFromItemAcl -Item $pageDataItem -RoleName $roleName
                $noteLines.Add((Get-AclChangeNote -ItemLabel "Page Data" -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
            } catch {
                $noteLines.Add("Page Data | ERROR: " + $_.Exception.Message)
            }
        }
    } else {
        $noteLines.Add("Page Data: folder not found")
    }

    # -- Remove from media folder and its ancestors --
    # Media-ancestor walk now runs in BOTH dry run and live mode (previously
    # was live-only, so dry run understated what would be touched).
    if ($matchingSite) {
        $siteFullPath      = $matchingSite.Paths.FullPath
        $relativePagePath  = $foundPageItem.Paths.FullPath.Substring($siteFullPath.Length).TrimStart("/")
        $siteName          = $matchingSite.Name
        $mediaFolderPath   = "$MediaLibraryRoot/$siteName/pages/$relativePagePath"
        $mediaFolderSCPath = "/sitecore/media library/Project/Intranet Evolution/DFD/$siteName/pages/$relativePagePath"

        $mediaFolderItem = Get-Item -Path $mediaFolderPath -ErrorAction SilentlyContinue

        if ($mediaFolderItem) {
            $reportRow.MediaFolder = $mediaFolderSCPath

            # Remove from the page media folder itself
            if ($dryRun) {
                $noteLines.Add((Get-AclChangeNote -ItemLabel "Media Folder" -AclResult $null -Item $mediaFolderItem -RoleName $roleName -IsDryRun $true))
            } else {
                try {
                    $aclResult = Remove-RoleFromItemAcl -Item $mediaFolderItem -RoleName $roleName
                    $noteLines.Add((Get-AclChangeNote -ItemLabel "Media Folder" -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
                } catch {
                    $noteLines.Add("Media Folder | ERROR: " + $_.Exception.Message)
                }
            }

            # Walk media ancestors (runs in dry run too)
            $mediaAncestorPath = Split-Path $mediaFolderPath -Parent
            while ($mediaAncestorPath -and $mediaAncestorPath -ne "master:") {
                $mediaAncestorItem = Get-Item -Path $mediaAncestorPath -ErrorAction SilentlyContinue
                if ($mediaAncestorItem) {
                    if ($dryRun) {
                        $noteLines.Add((Get-AclChangeNote -ItemLabel ("Media Ancestor: " + $mediaAncestorItem.Name) -AclResult $null -Item $mediaAncestorItem -RoleName $roleName -IsDryRun $true))
                    } else {
                        try {
                            $aclResult = Remove-RoleFromItemAcl -Item $mediaAncestorItem -RoleName $roleName
                            $noteLines.Add((Get-AclChangeNote -ItemLabel ("Media Ancestor: " + $mediaAncestorItem.Name) -AclResult $aclResult -Item $null -RoleName $roleName -IsDryRun $false))
                        } catch {
                            $noteLines.Add("Media Ancestor: " + $mediaAncestorItem.Name + " | ERROR: " + $_.Exception.Message)
                        }
                    }
                }
                $mediaAncestorPath = Split-Path $mediaAncestorPath -Parent
            }
        } else {
            $reportRow.MediaFolder = $mediaFolderSCPath
            $noteLines.Add("Media Folder: not found (may not have been created)")
        }
    }

    $reportRow.Notes = $noteLines -join $noteSeparator
    $report += $reportRow
}

} finally {
    if ($eventDisabler) { $eventDisabler.Dispose() }
}

Write-Progress -Activity "Removing Page Owner Permissions" -Completed


# ============================================================
# 8: Optionally delete roles from Sitecore
#    Appends one report row per unique role into $roleReport
# ============================================================
$roleReport = @()

if ($removeRolesFromSitecore) {
    Write-Host "Processing role deletion..." -ForegroundColor Cyan
    foreach ($roleName in $allCsvRoles) {
        $roleReportRow = [PSCustomObject]@{
            Role   = $roleName
            Status = ""
            Notes  = ""
        }

        if ($dryRun) {
            $role = Get-Role -Identity $roleName -ErrorAction SilentlyContinue
            if ($role) {
                $roleReportRow.Status = "DRY_RUN"
                $roleReportRow.Notes  = "Role exists - would be deleted"
            } else {
                $roleReportRow.Status = "DRY_RUN"
                $roleReportRow.Notes  = "Role not found - nothing to delete"
            }
        } else {
            $role = Get-Role -Identity $roleName -ErrorAction SilentlyContinue
            if ($role) {
                try {
                    Remove-Role -Identity $roleName
                    $roleReportRow.Status = "ROLE_DELETED"
                    $roleReportRow.Notes  = "Role permanently deleted"
                    Write-Host ("[DELETED] Role: $roleName") -ForegroundColor Red
                } catch {
                    $roleReportRow.Status = "ROLE_DELETE_ERROR"
                    $roleReportRow.Notes  = $_.Exception.Message
                    Write-Host ("[ERR] Could not delete role '$roleName': " + $_.Exception.Message) -ForegroundColor Red
                }
            } else {
                $roleReportRow.Status = "ROLE_NOT_FOUND"
                $roleReportRow.Notes  = "Role not found in Sitecore - skipped"
                Write-Host ("[WARN] Role not found, skipping delete: $roleName") -ForegroundColor Yellow
            }
        }

        $roleReport += $roleReportRow
    }
}


# ============================================================
# 9: Output permission removal report via Show-ListView
# ============================================================
$reportTitle = if ($dryRun) { "Permission Removal Report (DRY RUN)" } else { "Permission Removal Report" }
$infoTitle   = if ($dryRun) { "DRY RUN - " + $report.Count + " rows previewed, no changes made" } else { "Results: " + $report.Count + " rows processed" }

$report | Show-ListView `
    -Property `
        @{ Label = "Status";       Expression = { $_.Status } },
        @{ Label = "Item Path";    Expression = { $_.ItemPath } },
        @{ Label = "Role";         Expression = { $_.Role } },
        @{ Label = "Media Folder"; Expression = { $_.MediaFolder } },
        @{ Label = "Notes";        Expression = { $_.Notes } } `
    -Title $reportTitle `
    -InfoTitle $infoTitle `
    -PageSize 50


# ============================================================
# 10: Output role deletion report via Show-ListView (only if checkbox was ticked)
# ============================================================
if ($removeRolesFromSitecore -and $roleReport.Count -gt 0) {
    $roleReportTitle = if ($dryRun) { "Role Deletion Report (DRY RUN)" } else { "Role Deletion Report" }
    $roleInfoTitle   = if ($dryRun) { "DRY RUN - " + $roleReport.Count + " roles previewed, none deleted" } else { "Results: " + $roleReport.Count + " roles processed" }

    $roleReport | Show-ListView `
        -Property `
            @{ Label = "Status"; Expression = { $_.Status } },
            @{ Label = "Role";   Expression = { $_.Role } },
            @{ Label = "Notes";  Expression = { $_.Notes } } `
        -Title $roleReportTitle `
        -InfoTitle $roleInfoTitle `
        -PageSize 50
}


# ============================================================
# 11: Console summary
# ============================================================
$removed          = ($report     | Where-Object { $_.Status -eq "PERMISSIONS_REMOVED"  }).Count
$dryRunRows       = ($report     | Where-Object { $_.Status -eq "DRY_RUN"              }).Count
$missing          = ($report     | Where-Object { $_.Status -eq "MISSING_PAGE"         }).Count
$permErrors       = ($report     | Where-Object { $_.Status -eq "PERMISSIONS_ERROR"    }).Count
$rolesDeleted     = ($roleReport | Where-Object { $_.Status -eq "ROLE_DELETED"         }).Count
$rolesNotFound    = ($roleReport | Where-Object { $_.Status -eq "ROLE_NOT_FOUND"       }).Count
$roleDeleteErrors = ($roleReport | Where-Object { $_.Status -eq "ROLE_DELETE_ERROR"    }).Count

if ($dryRun) {
    Write-Host ("DRY RUN complete. DRY_RUN: " + $dryRunRows + " | MISSING_PAGE: " + $missing) -ForegroundColor Yellow
} else {
    $summary = "Done. PERMISSIONS_REMOVED: $removed | MISSING_PAGE: $missing | PERMISSIONS_ERROR: $permErrors"
    if ($removeRolesFromSitecore) {
        $summary += " | ROLE_DELETED: $rolesDeleted | ROLE_NOT_FOUND: $rolesNotFound | ROLE_DELETE_ERROR: $roleDeleteErrors"
    }
    Write-Host $summary -ForegroundColor Green
}
