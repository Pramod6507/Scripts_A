# ============================================================
# 5: PHASE 1 - Process each CSV row, QUEUE rules in memory
# No DB writes happen in this phase. Every Add-PendingRules call
# just appends to $aclQueue. The single flush happens in Phase 2.
# ============================================================
$propagationType = if ($applyToDescendants) { "Any" } else { "Entity" }

$report           = @()
$totalRows        = $validRows.Count
$currentRow       = 0
# $processedRoles tracks which roles have already had archive/publish UI denies queued.
$processedRoles   = [System.Collections.Generic.HashSet[string]]::new()

# Environment-specific: stop ancestor walk before this path so script-owned ancestor
# Read permissions stay one level below Home.
$homeContentPath = "/sitecore/content/Intranet Evolution/DFD/Home"
$dfdMediaPath    = "master:\sitecore\media library\Project\Intranet Evolution\DFD"

$eventDisabler = New-Object Sitecore.Data.Events.EventDisabler

try {
    foreach ($row in $validRows) {
        $currentRow++
        Write-Progress -Activity "Phase 1: Queueing ACL rules" `
                       -Status ("Row " + $currentRow + " of " + $totalRows + " - " + $row.$roleColumn) `
                       -PercentComplete (($currentRow / $totalRows) * 100)
        $itemPath = $row.$itemPathColumn.Trim()
        $roleName = ($row.$roleColumn.Trim() -replace "[^\x20-\x7E]", "").Trim()
        $owner    = if ($ownerColumn) { $row.$ownerColumn } else { "" }

        $reportRow = [PSCustomObject]@{
            ItemPath    = $itemPath
            Role        = $roleName
            Owner       = $owner
            Status      = ""
            MediaFolder = ""
            Notes       = ""
        }

        # Ensure role has sitecore\Page Owner Base as a member role.
        # This is the only DB-mutating action that happens during Phase 1; it's safe
        # because role membership is a separate system from item ACLs.
        if ($dryRun) {
            $role            = Get-Role -Identity $roleName -ErrorAction SilentlyContinue
            $existingMembers = if ($role) { Get-RoleMember -Identity $roleName -ErrorAction SilentlyContinue } else { @() }
            $alreadyMember   = $existingMembers | Where-Object { $_.Name -eq $PageOwnerBaseRole }
            if (-not $role) {
                $reportRow.Notes += "Role does not exist - would be created with base role | "
            } elseif ($alreadyMember) {
                $reportRow.Notes += "Base role already assigned | "
            } else {
                $reportRow.Notes += "Base role would be assigned | "
            }
        } else {
            $baseRoleResult = Ensure-BaseRole -RoleName $roleName
            $noteMsg = switch ($baseRoleResult) {
                "CREATED"        { "Role created + base role assigned | " }
                "ADDED"          { "Base role assigned | " }
                "ALREADY_MEMBER" { "Base role already set | " }
                default          { "Base role result: $baseRoleResult | " }
            }
            $reportRow.Notes += $noteMsg
        }

        # Resolve Sitecore item path to SPE provider path
        $scPath = $itemPath -replace "^/sitecore", "master:"
        $scPath = $scPath -replace "/", "\"
        $foundPageItem = Get-Item -Path $scPath -ErrorAction SilentlyContinue

        if (-not $foundPageItem) {
            $reportRow.Status = "MISSING_PAGE"
            $reportRow.Notes  = "Item not found at path: $itemPath"
            $report += $reportRow
            continue
        }

        $matchingSite = Get-ParentSite -Item $foundPageItem -Sites $sites

        # Queue page-item Allow rules
        Add-PendingRules -Item $foundPageItem -RoleName $roleName -Permissions $allPermissions -PropagationType $propagationType
        if ($dryRun) {
            $reportRow.Status = "DRY_RUN"
            $reportRow.Notes  += "Page permissions queued | "
        } else {
            $reportRow.Status = "PERMISSIONS_QUEUED"
            $reportRow.Notes  += "Page permissions queued | "
        }

        if (-not $matchingSite) {
            $reportRow.Notes += "No matching _AscensionSite ancestor found | "
        }

        # Queue ancestor Read on each ancestor of the page so the role can navigate.
        # Walk up from page parent to one level below Home.
        $ancestorItem  = $foundPageItem.Parent
        $ancestorNames = @()
        while ($ancestorItem -and $ancestorItem.Paths.FullPath -ne $homeContentPath -and $ancestorItem.ID -ne [Sitecore.Data.ID]::Parse("{11111111-1111-1111-1111-111111111111}")) {
            Add-PendingRules -Item $ancestorItem -RoleName $roleName -Permissions $ancestorReadPermissions -PropagationType "Entity"
            $ancestorNames += $ancestorItem.Name
            $ancestorItem = $ancestorItem.Parent
        }
        $reportRow.Notes += "Ancestor Read queued on: " + ($ancestorNames -join " > ") + " (stopped before Home) | "

        # Queue per-role one-time work: archive + publish restrictions UI denies in core DB.
        if (-not $processedRoles.Contains($roleName)) {
            Queue-ArchiveRestrictions -RoleName $roleName
            Queue-PublishRestrictionsPolicy -RoleName $roleName
            $processedRoles.Add($roleName) | Out-Null
            $reportRow.Notes += "Archive commands queued | Publish Restrictions queued | "
        }

        # Build media folder path using the page's relative path under the site
        if ($matchingSite) {
            $siteName     = $matchingSite.Name
            $siteFullPath = $matchingSite.Paths.FullPath

            $relativePagePath  = $foundPageItem.Paths.FullPath.Substring($siteFullPath.Length).TrimStart("/")
            $mediaFolderPath   = "$MediaLibraryRoot/$siteName/pages/$relativePagePath"
            $mediaFolderSCPath = "/sitecore/media library/Project/Intranet Evolution/DFD/$siteName/pages/$relativePagePath"

            # Create media folder. This is a real Sitecore item creation, not just an ACL,
            # so it has to happen during Phase 1 - but it's idempotent (re-runs find existing).
            if ($dryRun) {
                if (Test-Path $mediaFolderPath) {
                    $reportRow.MediaFolder = $mediaFolderSCPath
                    $reportRow.Notes += "Media folder already exists | "
                    $mediaFolderItem = Get-Item -Path $mediaFolderPath -ErrorAction SilentlyContinue
                } else {
                    $reportRow.MediaFolder = $mediaFolderSCPath
                    $reportRow.Notes += "Media folder would be created | "
                    $mediaFolderItem = $null
                }
            } else {
                $mediaFolderItem = Ensure-MediaFolder -Path $mediaFolderPath
                if ($mediaFolderItem) {
                    $reportRow.MediaFolder = $mediaFolderSCPath
                } else {
                    $reportRow.Notes += "Media folder creation failed | "
                }
            }

            # Queue ACL rules on each media-tree item we touch.
            # Ancestors above 'pages' get Read only; page folder + descendants get full.
            if ($mediaFolderItem) {
                $ancestorPath = Split-Path $mediaFolderPath -Parent
                while ($ancestorPath -and $ancestorPath -ne "master:" -and $ancestorPath -ne $dfdMediaPath) {
                    $ancestorMediaItem = Get-Item -Path $ancestorPath -ErrorAction SilentlyContinue
                    if ($ancestorMediaItem) {
                        $folderName = Split-Path $ancestorPath -Leaf

                        if ($folderName -eq "pages") {
                            Add-PendingRules -Item $ancestorMediaItem -RoleName $roleName -Permissions $mediaAncestorPermissions -PropagationType "Entity"
                        } elseif ($ancestorPath -match "\\pages\\") {
                            Add-PendingRules -Item $ancestorMediaItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Entity"
                            Add-PendingRules -Item $ancestorMediaItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Descendants"
                        } else {
                            Add-PendingRules -Item $ancestorMediaItem -RoleName $roleName -Permissions $mediaAncestorPermissions -PropagationType "Entity"
                        }
                    }
                    $ancestorPath = Split-Path $ancestorPath -Parent
                }

                # Page media folder gets Read/Write/Create on Entity + Descendants
                Add-PendingRules -Item $mediaFolderItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Entity"
                Add-PendingRules -Item $mediaFolderItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Descendants"
                $reportRow.Notes += "Media folder ACLs queued | "
            }
        }

        # Queue Page Data subfolder rules
        $pageDataPath = ($scPath + "\Page Data")
        $pageDataItem = Get-Item -Path $pageDataPath -ErrorAction SilentlyContinue

        if ($pageDataItem) {
            Add-PendingRules -Item $pageDataItem -RoleName $roleName -Permissions $pageDataPermissions -PropagationType "Any"
            $reportRow.Notes += "Page Data queued | "
        } else {
            $reportRow.Notes += "Page Data folder not found | "
        }

        # Queue Ascension Site Data rules
        if ($matchingSite) {
            $siteDataItem = $matchingSite.Children | Where-Object {
                $_.TemplateID.ToString() -eq $AscensionSiteDataTemplateId
            } | Select-Object -First 1

            if ($siteDataItem) {
                Add-PendingRules -Item $siteDataItem -RoleName $roleName -Permissions $siteDataAllowPermissions -PropagationType "Any"
                $reportRow.Notes += "Site Data (" + $siteDataItem.Name + ") queued | "
            } else {
                $reportRow.Notes += "Ascension Site Data item not found under site: " + $matchingSite.Name + " | "
            }
        }

        $report += $reportRow
    }

    Write-Progress -Activity "Phase 1: Queueing ACL rules" -Completed


    # ============================================================
    # 6: PHASE 2 - FLUSH the queue. ONE Get-Item + Get-ItemAcl + Set-ItemAcl per unique item.
    # All reads happen before any writes for that item, so EventDisabler-induced staleness
    # is not a factor: we never read the same item again after writing it.
    # ============================================================
    $flushReport       = @()
    $totalItemsToFlush = $aclQueue.Keys.Count
    $flushIndex        = 0
    $flushOk           = 0
    $flushFailed       = 0
    $flushSkippedDry   = 0

    Write-Host ("Phase 2: " + $totalItemsToFlush + " unique items to flush.") -ForegroundColor Cyan

    foreach ($key in $aclQueue.Keys) {
        $flushIndex++
        $itemMeta  = $aclItems[$key]
        $itemPath  = $itemMeta.Path
        $database  = $itemMeta.Database
        $providerPath = $database + ":" + $itemPath
        $newRules  = $aclQueue[$key]

        Write-Progress -Activity "Phase 2: Flushing ACLs" `
                       -Status ($flushIndex.ToString() + " of " + $totalItemsToFlush + " - " + $itemPath) `
                       -PercentComplete (($flushIndex / [Math]::Max(1, $totalItemsToFlush)) * 100)

        $flushRow = [PSCustomObject]@{
            ItemPath    = $providerPath
            QueuedRules = $newRules.Count
            FinalRules  = ""
            Status      = ""
            Notes       = ""
        }

        if ($dryRun) {
            $flushRow.Status = "DRY_RUN"
            $flushRow.Notes  = "Would write " + $newRules.Count + " queued rule(s) plus existing ACL"
            $flushSkippedDry++
            $flushReport += $flushRow
            continue
        }

        try {
            $freshItem = Get-Item -Path $providerPath -ErrorAction Stop
            $existing  = @(Get-ItemAcl -Item $freshItem)
            $allRules  = $existing + @($newRules)
            Set-ItemAcl -Item $freshItem -AccessRules $allRules | Out-Null

            $flushRow.Status     = "FLUSHED"
            $flushRow.FinalRules = $allRules.Count
            $flushRow.Notes      = "existing=" + $existing.Count + " queued=" + $newRules.Count + " final=" + $allRules.Count
            $flushOk++
        } catch {
            $flushRow.Status = "FLUSH_ERROR"
            $flushRow.Notes  = $_.Exception.Message
            $flushFailed++
        }

        $flushReport += $flushRow
    }

    Write-Progress -Activity "Phase 2: Flushing ACLs" -Completed
} finally {
    $eventDisabler.Dispose()
}


# ============================================================
# 7: Output reports - Phase 1 row-level + Phase 2 flush summary
# ============================================================
$reportTitle = if ($dryRun) { "Bulk Page Owner Report (DRY RUN) - Phase 1: Rows" } else { "Bulk Page Owner Report - Phase 1: Rows" }
$infoTitle   = if ($dryRun) { "DRY RUN - " + $report.Count + " rows previewed" } else { "Phase 1: " + $report.Count + " rows processed (queueing only)" }

$report | Show-ListView `
    -Property `
        @{ Label = "Status";       Expression = { $_.Status } },
        @{ Label = "Item Path";    Expression = { $_.ItemPath } },
        @{ Label = "Role";         Expression = { $_.Role } },
        @{ Label = "Owner";        Expression = { $_.Owner } },
        @{ Label = "Media Folder"; Expression = { $_.MediaFolder } },
        @{ Label = "Notes";        Expression = { $_.Notes } } `
    -Title $reportTitle `
    -InfoTitle $infoTitle `
    -PageSize 50

$flushTitle = if ($dryRun) { "Phase 2: Flush Plan (DRY RUN)" } else { "Phase 2: Flush Results" }
$flushInfo  = if ($dryRun) {
    "DRY RUN - " + $flushSkippedDry + " items would be flushed, no writes made"
} else {
    "Flushed: " + $flushOk + " | Failed: " + $flushFailed + " | Total items: " + $flushReport.Count
}

$flushReport | Show-ListView `
    -Property `
        @{ Label = "Status";       Expression = { $_.Status } },
        @{ Label = "Item Path";    Expression = { $_.ItemPath } },
        @{ Label = "Queued Rules"; Expression = { $_.QueuedRules } },
        @{ Label = "Final Rules";  Expression = { $_.FinalRules } },
        @{ Label = "Notes";        Expression = { $_.Notes } } `
    -Title $flushTitle `
    -InfoTitle $flushInfo `
    -PageSize 50

# Phase 1 status counts
$queued     = ($report | Where-Object { $_.Status -eq "PERMISSIONS_QUEUED" }).Count
$dryRunRows = ($report | Where-Object { $_.Status -eq "DRY_RUN" }).Count
$missing    = ($report | Where-Object { $_.Status -eq "MISSING_PAGE" }).Count

if ($dryRun) {
    Write-Host ("DRY RUN complete. Phase 1 DRY_RUN: " + $dryRunRows + " | MISSING_PAGE: " + $missing + " | Phase 2 items that would be flushed: " + $flushSkippedDry) -ForegroundColor Yellow
} else {
    Write-Host ("Done. Phase 1 QUEUED: " + $queued + " | MISSING_PAGE: " + $missing + " | Phase 2 FLUSHED: " + $flushOk + " | FAILED: " + $flushFailed) -ForegroundColor Green
}
