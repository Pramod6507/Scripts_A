# ============================================================
# 6: Process each CSV row
# ============================================================
$propagationType = if ($applyToDescendants) { "Any" } else { "Entity" }

$report           = @()
$totalRows        = $validRows.Count
$currentRow       = 0
$processedRoles   = [System.Collections.Generic.HashSet[string]]::new()
$processedSites   = [System.Collections.Generic.HashSet[string]]::new()

$eventDisabler = New-Object Sitecore.Data.Events.EventDisabler

# DFD path - stop assigning ancestor permissions at this level (content tree and media library)
$dfdContentPath = "/sitecore/content/Intranet Evolution/DFD"
$dfdMediaPath   = "master:\sitecore\media library\Project\Intranet Evolution\DFD"

foreach ($row in $validRows) {
    $currentRow++
    Write-Progress -Activity "Bulk Assign Page Owner Permissions" `
                   -Status ("Row " + $currentRow + " of " + $totalRows + " - " + $row.$roleColumn) `
                   -PercentComplete (($currentRow / $totalRows) * 100)
    $itemPath = $row.$itemPathColumn.Trim()
    $roleName = ($row.$roleColumn.Trim() -replace "[^\x20-\x7E]", "").Trim()
    $owner    = if ($ownerColumn) { $row.$ownerColumn } else { "" }

    $reportRow = [PSCustomObject]@{
        ItemPath    = $itemPath
        Role        = $roleName
        Owner       = $owner
        Status      = ""
        MediaFolder = ""
        Notes       = ""
    }

    # Ensure role has sitecore\Page Owner Base as a member role
    # If role does not exist it will be created automatically
    if ($dryRun) {
        $role            = Get-Role -Identity $roleName -ErrorAction SilentlyContinue
        $existingMembers = if ($role) { Get-RoleMember -Identity $roleName -ErrorAction SilentlyContinue } else { @() }
        $alreadyMember   = $existingMembers | Where-Object { $_.Name -eq $PageOwnerBaseRole }
        if (-not $role) {
            $reportRow.Notes += "Role does not exist - would be created with base role | "
        } elseif ($alreadyMember) {
            $reportRow.Notes += "Base role already assigned | "
        } else {
            $reportRow.Notes += "Base role would be assigned | "
        }
    } else {
        $baseRoleResult = Ensure-BaseRole -RoleName $roleName
        $noteMsg = switch ($baseRoleResult) {
            "CREATED"        { "Role created + base role assigned | " }
            "ADDED"          { "Base role assigned | " }
            "ALREADY_MEMBER" { "Base role already set | " }
            default          { "Base role result: $baseRoleResult | " }
        }
        $reportRow.Notes += $noteMsg
    }

    # Resolve Sitecore item path to SPE provider path
    $scPath = $itemPath -replace "^/sitecore", "master:"
    $scPath = $scPath -replace "/", "\"
    $foundPageItem = Get-Item -Path $scPath -ErrorAction SilentlyContinue

    if (-not $foundPageItem) {
        $reportRow.Status = "MISSING_PAGE"
        $reportRow.Notes  = "Item not found at path: $itemPath"
        $report += $reportRow
        continue
    }

    # Find the parent site by walking up the ancestor chain
    $matchingSite = Get-ParentSite -Item $foundPageItem -Sites $sites

    # Step 1: Site-level restrictions are skipped because explicit denies are disabled.
    # False permission values are treated as no change by Set-PagePermissions.
    if ($matchingSite) {
        $siteRoleKey = $matchingSite.ID.ToString() + "|" + $roleName
        if (-not $processedSites.Contains($siteRoleKey)) {
            if ($dryRun) {
                $reportRow.Notes += "Dry run - site-level Deny would be set on: " + $matchingSite.Paths.FullPath + " | "
            } else {
                try {
                    Set-PagePermissions -Item $matchingSite -RoleName $roleName -Permissions $siteLevelDenyPermissions -PropagationType "Descendants"
                    $processedSites.Add($siteRoleKey) | Out-Null
                    $reportRow.Notes += "Site deny set on: " + $matchingSite.Name + " | "
                } catch {
                    $reportRow.Status = "PERMISSIONS_ERROR"
                    $reportRow.Notes  = "Site-level deny failed: " + $_.Exception.Message
                    $report += $reportRow
                    continue
                }
            }
        } else {
            $reportRow.Notes += "Site deny already set | "
        }
    }

    # Step 2: Allow page-level permissions on the specific page (overrides site deny)
    # Because the deny is Descendants on the site, and the Allow is Entity on the page item,
    # the explicit Allow wins for the assigned page only
    if ($dryRun) {
        $reportRow.Status = "DRY_RUN"
        $reportRow.Notes  += " | Dry run - page permissions would be set"
    } else {
        try {
            Set-PagePermissions -Item $foundPageItem -RoleName $roleName -Permissions $allPermissions -PropagationType $propagationType
            $reportRow.Status = "PERMISSIONS_SET"
            $reportRow.Notes += "Page permissions set | "
        } catch {
            $reportRow.Status = "PERMISSIONS_ERROR"
            $reportRow.Notes  = $_.Exception.Message
            $report += $reportRow
            continue
        }
    }

    if (-not $matchingSite) {
        $reportRow.Notes += " | No matching _AscensionSite ancestor found - site-level deny skipped."
    }

    # Set Read Allow on each ancestor of the page so the role can navigate the tree
    # Walk up from the page's parent to the DFD folder (stop before DFD - don't set permissions on DFD or above)
    # Permissions on DFD and higher folders should be set manually on the Page Owner Base role
    if (-not $dryRun) {
        $ancestorItem  = $foundPageItem.Parent
        $ancestorNames = @()
        while ($ancestorItem -and $ancestorItem.Paths.FullPath -ne $dfdContentPath -and $ancestorItem.ID -ne [Sitecore.Data.ID]::Parse("{11111111-1111-1111-1111-111111111111}")) {
            Set-PagePermissions -Item $ancestorItem -RoleName $roleName -Permissions $ancestorReadPermissions -PropagationType "Entity"
            $ancestorNames += $ancestorItem.Name
            $ancestorItem = $ancestorItem.Parent
        }
        $reportRow.Notes += "Ancestor Read set on: " + ($ancestorNames -join " > ") + " (stopped at DFD) | "
    } else {
        $reportRow.Notes += "Dry run - ancestor Read would be set (up to DFD) | "
    }

    # Build media folder path:
    # /sitecore/media library/Project/Intranet Evolution/DFD/[$matchingSite.name]/[$foundPageItem.Parent.name]/[$foundPageItem.name]
    $siteName       = $matchingSite.Name
    $pageParentName = $foundPageItem.Parent.Name
    $pageName       = $foundPageItem.Name

    # Build media folder path using the page's relative path under the site
    # e.g. site=mhp, page=/sitecore/content/.../mhp/Ministry Detail Page
    # -> media folder: MediaLibraryRoot/mhp/Ministry Detail Page
    $siteFullPath      = $matchingSite.Paths.FullPath
    # Insert "pages" between the site name and the page path to match the new media library structure:
    # Before: DFD/[site]/[page]
    # After:  DFD/[site]/pages/[page]
    $relativePagePath  = $foundPageItem.Paths.FullPath.Substring($siteFullPath.Length).TrimStart("/")
    $mediaFolderPath   = "$MediaLibraryRoot/$siteName/pages/$relativePagePath"
    $mediaFolderSCPath = "/sitecore/media library/Project/Intranet Evolution/DFD/$siteName/pages/$relativePagePath"

    # Media library permissions + archive restrictions:
    # Applied once per unique role using $processedRoles tracker
    # Step A - Deny everything on media library root
    # Step B - Restrict archive UI commands in core database
    if (-not $processedRoles.Contains($roleName)) {
        $mediaLibraryItem = Get-Item -Path "master:/sitecore/media library" -ErrorAction SilentlyContinue
        if ($mediaLibraryItem) {
            if ($dryRun) {
                $reportRow.Notes += " | Media library root: full deny would be set"
                $reportRow.Notes += " | Archive commands: Read deny would be set in core db"
            } else {
                try {
                    # Three separate rules to match the required permission pattern:
                    # Read Allow on item, Deny all on descendants, Deny write ops on item
                    Set-PagePermissions -Item $mediaLibraryItem -RoleName $roleName -Permissions $mediaRootReadItemPermissions -PropagationType "Entity"
                    Set-PagePermissions -Item $mediaLibraryItem -RoleName $roleName -Permissions $mediaRootDenyDescendantsPermissions -PropagationType "Descendants"
                    Set-PagePermissions -Item $mediaLibraryItem -RoleName $roleName -Permissions $mediaRootDenyItemPermissions -PropagationType "Entity"
                    $reportRow.Notes += " | Media library root: permissions set"
                } catch {
                    $reportRow.Notes += " | Media library root deny failed: $($_.Exception.Message)"
                }

                # Restrict archive UI commands - hides Archive/Restore from Content Editor ribbon
                try {
                    Set-ArchiveRestrictions -RoleName $roleName
                    $reportRow.Notes += " | Archive commands restricted"
                } catch {
                    $reportRow.Notes += " | Archive restriction failed: $($_.Exception.Message)"
                }

                # Restrict Publish Restrictions UI - hides the Change button from the ribbon
                # Prevents role from modifying publish restrictions which could unpublish pages
                try {
                    Set-PublishRestrictionsRestrictions -RoleName $roleName
                    $reportRow.Notes += " | Publish Restrictions restricted"
                } catch {
                    $reportRow.Notes += " | Publish Restrictions restriction failed: $($_.Exception.Message)"
                }

                $processedRoles.Add($roleName) | Out-Null
            }
        }
    }

    # Create media folder using Ensure-MediaFolder (recursive, correct media folder type)
    if ($dryRun) {
        if (Test-Path $mediaFolderPath) {
            $reportRow.MediaFolder = $mediaFolderSCPath
            $reportRow.Notes += " | Media folder already exists"
        } else {
            $reportRow.MediaFolder = $mediaFolderSCPath
            $reportRow.Notes += " | Media folder would be created"
        }
    } else {
        $mediaFolderItem = Ensure-MediaFolder -Path $mediaFolderPath

        if ($mediaFolderItem) {
            # Allow Read on ancestor folders from [site] down to (and including) the 'pages' folder
            # Stop at DFD level - do not assign permissions above DFD
            # Anything BELOW 'pages' is a page media folder, not an ancestor - gets full permissions
            $ancestorPath = Split-Path $mediaFolderPath -Parent
            while ($ancestorPath -and $ancestorPath -ne "master:" -and $ancestorPath -ne $dfdMediaPath) {
                $ancestorItem = Get-Item -Path $ancestorPath -ErrorAction SilentlyContinue
                if ($ancestorItem) {
                    $folderName = Split-Path $ancestorPath -Leaf
                    
                    if ($folderName -eq "pages") {
                        # 'pages' folder itself gets ancestor (read-only) permissions
                        Set-PagePermissions -Item $ancestorItem -RoleName $roleName -Permissions $mediaAncestorPermissions -PropagationType "Entity"
                    } elseif ($ancestorPath -match "\\pages\\") {
                        # This is a subfolder under 'pages' - give it full media permissions (Read/Write/Create)
                        Set-PagePermissions -Item $ancestorItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Entity"
                        Set-PagePermissions -Item $ancestorItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Descendants"
                    } else {
                        # This is above 'pages' (site folder, etc.) - give it ancestor (read-only) permissions
                        Set-PagePermissions -Item $ancestorItem -RoleName $roleName -Permissions $mediaAncestorPermissions -PropagationType "Entity"
                    }
                }
                $ancestorPath = Split-Path $ancestorPath -Parent
            }

            # Allow Read/Write/Create on the specific page media folder (Entity + Descendants)
            try {
                Set-PagePermissions -Item $mediaFolderItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Entity"
                Set-PagePermissions -Item $mediaFolderItem -RoleName $roleName -Permissions $mediaAllowPermissions -PropagationType "Descendants"
                $reportRow.MediaFolder = $mediaFolderSCPath
                $reportRow.Notes += " | Media folder: Read/Write/Create set"
            } catch {
                $reportRow.Notes += " | Media folder permissions failed: $($_.Exception.Message)"
            }
        } else {
            $reportRow.Notes += " | Media folder creation failed"
        }
    }

    # ---- Page Data folder: Allow Write + Create (page owner level) ----
    $pageDataPath = ($scPath + "\Page Data")
    $pageDataItem = Get-Item -Path $pageDataPath -ErrorAction SilentlyContinue

    if ($pageDataItem) {
        if ($dryRun) {
            $reportRow.Notes += " | Page Data folder found - Write+Create would be set"
        } else {
            try {
                Set-PagePermissions -Item $pageDataItem -RoleName $roleName -Permissions $pageDataPermissions -PropagationType "Any"
                $reportRow.Notes += " | Page Data: Write+Create set"
            } catch {
                $reportRow.Notes += " | Page Data permissions failed: $($_.Exception.Message)"
            }
        }
    } else {
        $reportRow.Notes += " | Page Data folder not found"
    }

    # ---- Ascension Site Data folder: Allow Read + Write + Create for page owners ----
    # Found by Ascension Site Data template ID - name varies per site (e.g. "Saint Thomas Data")
    if ($matchingSite) {
        $siteDataItem = $matchingSite.Children | Where-Object {
            $_.TemplateID.ToString() -eq $AscensionSiteDataTemplateId
        } | Select-Object -First 1

        if ($siteDataItem) {
            if ($dryRun) {
                $reportRow.Notes += " | Site Data folder found - Read/Write/Create would be set on: " + $siteDataItem.Name
            } else {
                try {
                    Set-PagePermissions -Item $siteDataItem -RoleName $roleName -Permissions $siteDataAllowPermissions -PropagationType "Any"
                    $reportRow.Notes += " | Site Data (" + $siteDataItem.Name + "): Read/Write/Create set"
                } catch {
                    $reportRow.Notes += " | Site Data permissions failed: $($_.Exception.Message)"
                }
            }
        } else {
            $reportRow.Notes += " | Ascension Site Data item not found under site: " + $matchingSite.Name
        }
    }

    # ---- Global data folder: Deny Write + Create (page owner level) ----
    $globalDataPath = "master:\content\Intranet Evolution\DFD\Data"
    $globalDataItem = Get-Item -Path $globalDataPath -ErrorAction SilentlyContinue

    if ($globalDataItem) {
        if ($dryRun) {
            $reportRow.Notes += " | Global Data folder found - Write+Create Deny would be confirmed"
        } else {
            try {
                Set-PagePermissions -Item $globalDataItem -RoleName $roleName -Permissions $dataFolderDenyPermissions -PropagationType "Any"
                $reportRow.Notes += " | Global Data: Write+Create denied"
            } catch {
                $reportRow.Notes += " | Global Data permissions failed: $($_.Exception.Message)"
            }
        }
    } else {
        $reportRow.Notes += " | Global Data folder not found"
    }

    $report += $reportRow
}


$eventDisabler.Dispose()

Write-Progress -Activity "Bulk Assign Page Owner Permissions" -Completed


# ============================================================
# 7: Output report via Show-ListView
# ============================================================
$reportTitle = if ($dryRun) { "Bulk Page Owner Report (DRY RUN)" } else { "Bulk Page Owner Report" }
$infoTitle   = if ($dryRun) { "DRY RUN - " + $report.Count + " rows previewed, no changes made" } else { "Results: " + $report.Count + " rows processed" }

$report | Show-ListView `
    -Property `
        @{ Label = "Status";       Expression = { $_.Status } },
        @{ Label = "Item Path";    Expression = { $_.ItemPath } },
        @{ Label = "Role";         Expression = { $_.Role } },
        @{ Label = "Owner";        Expression = { $_.Owner } },
        @{ Label = "Media Folder"; Expression = { $_.MediaFolder } },
        @{ Label = "Notes";        Expression = { $_.Notes } } `
    -Title $reportTitle `
    -InfoTitle $infoTitle `
    -PageSize 50

$permSet    = ($report | Where-Object { $_.Status -eq "PERMISSIONS_SET" }).Count
$dryRunRows = ($report | Where-Object { $_.Status -eq "DRY_RUN" }).Count
$missing    = ($report | Where-Object { $_.Status -eq "MISSING_PAGE" }).Count
$permErrors = ($report | Where-Object { $_.Status -eq "PERMISSIONS_ERROR" }).Count

if ($dryRun) {
    Write-Host ("DRY RUN complete. DRY_RUN: " + $dryRunRows + " | MISSING_PAGE: " + $missing) -ForegroundColor Yellow
} else {
    Write-Host ("Done. PERMISSIONS_SET: " + $permSet + " | MISSING_PAGE: " + $missing + " | PERMISSIONS_ERROR: " + $permErrors) -ForegroundColor Green
}

