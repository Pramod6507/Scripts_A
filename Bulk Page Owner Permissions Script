# Bulk Page Owner Permissions Script
# Reads a CSV of page paths and roles, sets permissions, finds the parent site
# by walking up the item ancestors, creates media library folders, and outputs a report.
# CSV must have columns matching: "Item path", "Role name", and optionally "author" or "owner"

# ============================================================
# REUSABLE FUNCTION: Apply allowed permissions to a Sitecore item
#    Explicit denies are intentionally skipped.
#    $true  = write AllowAccess
#    $false = no change
# ============================================================
function Set-PagePermissions {
    param(
        [Sitecore.Data.Items.Item] $Item,
        [string]                   $RoleName,
        [hashtable]                $Permissions,
        [string]                   $PropagationType = "Any",
        [bool]                     $AllowExplicitDeny = $false
    )

    $accessRules = @()
    foreach ($entry in $Permissions.GetEnumerator()) {
        # Default behavior: false means "no change" to avoid cascading deny behavior.
        # Exception: allow explicit deny only when requested by the caller.
        if (-not $entry.Value -and -not $AllowExplicitDeny) {
            continue
        }

        $securityPermission = if ($entry.Value) { "AllowAccess" } else { "DenyAccess" }

        $accessRules += New-ItemAcl `
            -Identity           $RoleName `
            -AccessRight        $entry.Key `
            -PropagationType    $PropagationType `
            -SecurityPermission $securityPermission
    }

    if ($accessRules.Count -gt 0) {
        $Item | Add-ItemAcl -AccessRules $accessRules -PassThru | Out-Null
    }
}


# ============================================================
# REUSABLE FUNCTION: Walk up ancestors to find the site item
#    Returns the first ancestor whose template matches _AscensionSite
# ============================================================
$SiteNameMappingFieldId  = "{76AC9A68-4039-4C03-A7B2-81C9080C2F13}"
$AscensionSiteTemplateId = [Sitecore.Data.ID]::Parse("{7F81B515-EB46-43D6-AF06-264740F66AC3}")

function Get-ParentSite {
    param(
        [Sitecore.Data.Items.Item] $Item,
        [System.Collections.Generic.List[object]] $Sites
    )
    # Match the page item path against the preloaded $sites list
    foreach ($site in $Sites) {
        if ($Item.Paths.FullPath -like ($site.Paths.FullPath + "*")) {
            return $site
        }
    }
    return $null
}


# ============================================================
# REUSABLE FUNCTION: Ensure a role has sitecore\Page Owner Base as a member role
#    Checks first - only assigns if not already a member
# ============================================================
$PageOwnerBaseRole       = "sitecore\Page Owner Base"
$AscensionSiteDataTemplateId = "{88072C0A-6A7D-4992-93FA-F37AE67023AA}"

function Ensure-BaseRole {
    param([string]$RoleName)

    $role = Get-Role -Identity $RoleName -ErrorAction SilentlyContinue

    if (-not $role) {
        New-Role -Identity $RoleName
        # Add $RoleName as a member of Page Owner Base (not the other way around)
        Add-RoleMember -Identity $PageOwnerBaseRole -Member $RoleName
        return "CREATED"
    }

    # Check if $RoleName is already a member of Page Owner Base
    $existingMembers = Get-RoleMember -Identity $PageOwnerBaseRole -ErrorAction SilentlyContinue
    $alreadyMember   = $existingMembers | Where-Object { $_.Name -eq $RoleName }

    if ($alreadyMember) {
        return "ALREADY_MEMBER"
    }

    # Add $RoleName as a member of Page Owner Base
    Add-RoleMember -Identity $PageOwnerBaseRole -Member $RoleName
    return "ADDED"
}


# ============================================================
# REUSABLE FUNCTION: Restrict archive commands for a role in the core database
# ============================================================
# Read-deny permission map for archive command items
$archiveDenyPermissions = [ordered]@{
    "item:read" = $false
}

# Archive command paths in the core database
$ArchiveCommandPaths = @(
    "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Schedule",
    "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Schedule/Archive"
)

function Set-ArchiveRestrictions {
    param([string]$RoleName)

    foreach ($archivePath in $ArchiveCommandPaths) {
        $archiveItem = Get-Item -Path $archivePath -ErrorAction SilentlyContinue
        if ($archiveItem) {
            Set-PagePermissions -Item $archiveItem -RoleName $RoleName -Permissions $archiveDenyPermissions -PropagationType "Entity" -AllowExplicitDeny $true
            Write-Host ("[INFO] Archive restricted: " + $archivePath + " for " + $RoleName) -ForegroundColor Gray
        } else {
            Write-Host ("[WARN] Archive item not found: " + $archivePath) -ForegroundColor Yellow
        }
    }
}


# ============================================================
# REUSABLE FUNCTION: Restrict Publish Restrictions UI for a role in the core database
# ============================================================
$PublishRestrictionsChunkPath  = "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Publish Restrictions"
$PublishRestrictionsChangePath = "core:/sitecore/content/Applications/Content Editor/Ribbons/Chunks/Publish Restrictions/Change"

# Read-deny permission map for publish restrictions items (same as archive deny)
$publishRestrictionsDenyPermissions = [ordered]@{
    "item:read" = $false
}

function Set-PublishRestrictionsRestrictions {
    param([string]$RoleName)

    # Restrict both the parent chunk and the Change button item
    # Denying the chunk hides the entire group from the ribbon
    # Denying the Change button provides defence in depth if the chunk is ever re-enabled
    $publishPaths = @(
        $PublishRestrictionsChunkPath,
        $PublishRestrictionsChangePath
    )

    foreach ($publishPath in $publishPaths) {
        $publishItem = Get-Item -Path $publishPath -ErrorAction SilentlyContinue
        if ($publishItem) {
            Set-PagePermissions -Item $publishItem -RoleName $RoleName -Permissions $publishRestrictionsDenyPermissions -PropagationType "Entity" -AllowExplicitDeny $true
            Write-Host ("[INFO] Publish Restrictions restricted: " + $publishPath + " for " + $RoleName) -ForegroundColor Gray
        } else {
            Write-Host ("[WARN] Publish Restrictions item not found: " + $publishPath) -ForegroundColor Yellow
        }
    }
}


# ============================================================
# REUSABLE FUNCTION: Ensure a media library folder exists, creating recursively if needed
# ============================================================
$MediaLibraryRoot = "master:/sitecore/media library/Project/Intranet Evolution/DFD"

function Ensure-MediaFolder {
    param([string]$Path)

    # Build list of path segments that need to be created, from deepest to shallowest
    $pathsToCreate = [System.Collections.Generic.List[string]]::new()
    $current = $Path
    while ($current -and -not (Test-Path $current)) {
        $pathsToCreate.Insert(0, $current)
        $current = Split-Path $current -Parent
    }

    # Create each missing segment from shallowest to deepest
    $lastItem = $null
    foreach ($p in $pathsToCreate) {
        $parentPath = Split-Path $p -Parent
        $folderName = Split-Path $p -Leaf
        $newFolder  = New-Item -Path $parentPath -Name $folderName `
                               -ItemType "System/Media/Media folder" `
                               -ErrorAction SilentlyContinue
        if ($newFolder) {
            Write-Host ("[CREATED] " + $p) -ForegroundColor Green
            $lastItem = $newFolder
        } else {
            Write-Host ("[ERR]  Failed to create folder: " + $p) -ForegroundColor Red
            return $null
        }
    }

    if ($lastItem) { return $lastItem }
    return Get-Item -Path $Path -ErrorAction SilentlyContinue
}


